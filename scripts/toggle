#!/usr/bin/env bash
# Show or hide bcal on the Hyprland special workspace "bcal", starting it
# there if it is not running. Bound to LEADER o c (hypr/lua/leader.lua; the
# window rule bcal-special in rules.lua sends the window to the workspace).
# Uses the last build in out/; run `npm run build` after changes.
set -euo pipefail
cd "$(dirname "$0")/.."

if hyprctl clients -j | jq -e '.[] | select(.title == "bcal")' >/dev/null; then
  hyprctl dispatch 'hl.dsp.workspace.toggle_special("bcal")' >/dev/null
  exit
fi

[ -f out/main/index.js ] || nix develop -c npx electron-vite build >/dev/null
setsid nix develop -c electron . >/dev/null 2>&1 &
for _ in $(seq 1 60); do
  sleep 0.5
  if hyprctl clients -j | jq -e '.[] | select(.title == "bcal")' >/dev/null; then
    hyprctl dispatch 'hl.dsp.workspace.toggle_special("bcal")' >/dev/null
    exit
  fi
done
echo "bcal did not come up" >&2
exit 1
